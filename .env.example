# Domain for HTTPS. Without your own domain use the free sslip.io name of your server IP:
#   IP 203.0.113.7  ->  DOMAIN=203-0-113-7.sslip.io
DOMAIN=203-0-113-7.sslip.io

# Login
AUTH_USERNAME=admin
# Preferred: a password hash (npm run hash-password, or install.sh does it for you).
# Keep the single quotes — the hash contains "$".
AUTH_PASSWORD_HASH=''
# Alternative: plain password (hashed in memory at startup). Use one of the two.
# AUTH_PASSWORD=change-me-to-something-long

# How long a login stays valid, days
SESSION_DAYS=30

# BitTorrent ports — open them in the firewall:
#   TORRENT_PORT: TCP + UDP (peer connections over TCP and uTP)
#   DHT_PORT:     UDP (peer discovery); defaults to TORRENT_PORT + 1
TORRENT_PORT=51413
DHT_PORT=51414

# Download speed limit in KB/s, -1 = unlimited. Seeding (off by default) and its
# upload limit are controlled in the web UI.
DOWNLOAD_LIMIT_KBPS=-1
MAX_CONNS=100
